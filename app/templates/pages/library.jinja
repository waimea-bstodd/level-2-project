{% extends "_base.jinja" %}
{% block content %}
    <h2>My Library</h2>
    
    <h3>Playlists <a href="/playlist/new" style="font-size: 1rem; margin-left: 1rem;">[New]</a></h3>
    <ul>
        {% for playlist in playlists %}
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 5px;">
                <a href="/playlist/{{ playlist.id }}">{{ playlist.name }}</a>
                <form action="/playlist/{{ playlist.id }}/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this playlist?');">
                    <button type="submit" style="color: red; background: none; border: none; cursor: pointer; text-decoration: underline; padding: 0;">[Delete]</button>
                </form>
            </li>
        {% else %}
            <li>No playlists found.</li>
        {% endfor %}
    </ul>

    <hr style="margin: 2rem 0;">

    <h3>All Tracks</h3>
    

    <div id="notes">
        {% for track in tracks %}
            <article class="note">
                <header style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <h3 style="margin: 0;">{{ track.title }}</h3>
                    <form action="/track/{{ track.id }}/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this track? This will remove the file permanently.');">
                        <button type="submit" style="color: white; background-color: #d9534f; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer;">Delete</button>
                    </form>
                </header>
                <p><strong>Artist:</strong> {{ track.artist }}</p>
                <audio controls src="/static/uploads/{{ track.filename }}" style="width: 100%; margin-top: 1rem;"></audio>
            </article>
        {% endfor %}
    </div>
{% endblock %}