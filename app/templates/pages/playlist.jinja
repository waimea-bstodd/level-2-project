{% extends "_base.jinja" %}
{% block content %}
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 style="margin: 0;">Playlist: {{ playlist.name }}</h2>
        <form action="/playlist/{{ playlist.id }}/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this playlist?');">
            <button type="submit" style="color: white; background-color: #d9534f; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer;">Delete Playlist</button>
        </form>
    </div>

    <div id="notes">
        {% for track in tracks %}
            <article class="note">
                <header><h3>{{ track.title }}</h3></header>
                <p><strong>Artist:</strong> {{ track.artist }}</p>
                <audio controls src="/static/uploads/{{ track.filename }}" style="width: 100%; margin-top: 1rem;"></audio>
            </article>
        {% else %}
            <p>No tracks in this playlist.</p>
        {% endfor %}
    </div>
{% endblock %}